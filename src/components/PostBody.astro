---
import { Block } from '../lib/interfaces.ts'
import NotionBlocks from './NotionBlocks.astro'

export interface Props {
  blocks: Block[]
}

const { blocks } = Astro.props
---

<div class="post-body">
  <NotionBlocks blocks={blocks} isRoot={true} />
</div>

<style>
  .post-body {
    padding: 0.5rem 0;
  }

  .post-body img {
    max-width: 100%;
    height: auto;
  }

  .post-body iframe,
  .post-body object,
  .post-body embed {
    max-width: 100%;
  }
</style>
