---
import { Post } from '../lib/interfaces.ts'

export interface Props {
  post: Post
}

const { post } = Astro.props
---

{post.Excerpt && (
  <div class="post-excerpt">
    <p>{post.Excerpt}</p>
  </div>
)}

<style>
  .post-excerpt {
    padding: 0.2rem 0;
  }

  .post-excerpt p {
    margin: 0;
    color: var(--fg-subtle);
    font-size: 0.9rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
