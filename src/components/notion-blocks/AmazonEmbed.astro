---
import { getAmazonAsin } from '../../lib/blog-helpers.ts'

export interface Props {
  url: URL
  metadata?: Record<string, string>
}

const { url, metadata } = Astro.props

const asin = getAmazonAsin(url)
const title = metadata?.title || 'Amazon.co.jp で見る'
const description = metadata?.description || ''

// Prioritize ASIN based image for Amazon as it's more stable
let image = ''
if (asin) {
  const hostname = url.hostname.toLowerCase()
  const domain = hostname.includes('amazon.co.jp') ? 'fe' : 'na'
  image = `https://images-${domain}.ssl-images-amazon.com/images/P/${asin}.09.LZZZZZZZ.jpg`
}

if (!image && metadata?.image) {
  image = metadata.image
}
---

<div class="amazon-embed">
  <a href={url.toString()} target="_blank" rel="noopener noreferrer">
    <div class="amazon-embed-content">
      <div class="amazon-embed-text">
        <div class="amazon-embed-title">{title}</div>
        <div class="amazon-embed-description">{description}</div>
        <div class="amazon-embed-site">
          <div class="amazon-embed-favicon">
            <img
              src={`https://www.google.com/s2/favicons?domain=${url.hostname}`}
              alt="Amazon Favicon"
              loading="lazy"
            />
          </div>
          <div class="amazon-embed-origin">{url.origin}</div>
        </div>
      </div>
      {
        image && (
          <div class="amazon-embed-image">
            <img src={image} alt={title} loading="lazy" />
          </div>
        )
      }
    </div>
  </a>
</div>

<style>
  .amazon-embed {
    display: flex;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    font-size: 0.9rem;
    margin: 1rem 0;
  }
  .amazon-embed > a {
    width: 100%;
    box-sizing: border-box;
    text-decoration: none;
    border: 1px solid rgba(55, 53, 47, 0.16);
    border-radius: 3px;
    display: flex;
    overflow: hidden;
    user-select: none;
    background-color: #fdfdfd;
    transition: background 120ms ease-in;
  }
  .amazon-embed > a:hover {
    background-color: #f5f5f5;
  }
  .amazon-embed-content {
    display: flex;
    width: 100%;
    overflow: hidden;
    min-height: 120px;
  }
  .amazon-embed-text {
    flex: 4 1 180px;
    padding: 12px 14px 14px;
    overflow: hidden;
    text-align: left;
    color: var(--fg);
  }
  .amazon-embed-title {
    width: 120px;
    min-width: 100%;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 24px;
    margin-bottom: 2px;
  }
  .amazon-embed-description {
    font-size: 12px;
    line-height: 16px;
    opacity: 0.8;
    height: 32px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .amazon-embed-site {
    display: flex;
    margin-top: 6px;
    align-items: center;
  }
  .amazon-embed-favicon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-right: 6px;
  }
  .amazon-embed-favicon img {
    max-width: 100%;
    display: block;
  }
  .amazon-embed-origin {
    font-size: 12px;
    line-height: 16px;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .amazon-embed-image {
    flex: 1 1 120px;
    max-width: 150px;
    min-width: 80px;
    position: relative;
    background-color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid rgba(55, 53, 47, 0.08);
  }
  .amazon-embed-image img {
    display: block;
    max-width: 100%;
    max-height: 120px;
    padding: 4px;
    object-fit: contain;
  }
  @media (max-width: 640px) {
    .amazon-embed-image {
      flex: 0 0 80px;
      min-width: 80px;
    }
    .amazon-embed-title {
      font-size: 13px;
    }
  }
</style>
