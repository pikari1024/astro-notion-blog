---
import { RichText } from '../../lib/interfaces.ts'
import RichTextComponent from './RichText.astro'

export interface Props {
  richTexts: RichText[]
}

const { richTexts } = Astro.props
---

{
  richTexts.length > 0 && (
    <div class="caption">
      <div>
        {richTexts.map((richText) => (
          <RichTextComponent richText={richText} />
        ))}
      </div>
    </div>
  )
}

<style>
  .caption {
    display: flex;
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--accents-3);
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.4;
  }
  .caption > div {
    flex-grow: 1;
    width: 0;
  }
</style>
